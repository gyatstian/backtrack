    <BacktrackNoiseSuppression Condition="'$(BacktrackNoiseSuppression)'==''">false</BacktrackNoiseSuppression>
    <!-- Encoder SDK header detection, mirroring CMake's find_path. Both are
         always defined as 1 or 0 so a backend whose headers are missing compiles
         to an "unavailable" stub instead of failing the build. src/Interface is
         vendored; only the NVIDIA headers may legitimately be absent. -->
    <BacktrackNvencHeaders Condition="'$(BacktrackNvencHeaders)'=='' and Exists('$(ProjectDir)src\Interface\nvEncodeAPI.h')">1</BacktrackNvencHeaders>
    <BacktrackNvencHeaders Condition="'$(BacktrackNvencHeaders)'==''">0</BacktrackNvencHeaders>
    <BacktrackAmfHeaders Condition="'$(BacktrackAmfHeaders)'=='' and Exists('$(ProjectDir)src\Interface\AMF\core\Factory.h')">1</BacktrackAmfHeaders>
    <BacktrackAmfHeaders Condition="'$(BacktrackAmfHeaders)'==''">0</BacktrackAmfHeaders>
  </PropertyGroup>

